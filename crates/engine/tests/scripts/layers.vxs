# Layer jumps (the Minimap's Surface / Underground / Sky buttons): each lands somewhere to stand
# in its layer, and the layers stream around it (the others only nearby).
ui off
anim 12
time 0.4
pos 144 136 -368
look 90 -5
settle

# a cave near y -400 in the upper caves
layer_jump underground -400
settle
wait 60
expect_image crates/engine/tests/golden/jump_underground.png

# on a sky island above the cloud sea
layer_jump sky
settle
wait 60
expect_image crates/engine/tests/golden/jump_sky.png

# back on the surface (above the river there)
layer_jump surface
settle
wait 60
expect_image crates/engine/tests/golden/jump_surface.png

# Connections cross the layers. The CPU places them the way the generator does (find_connection),
# a sinkhole is a dry shaft through the surface, both blend bands and the upper caves down to a
# cavern, and a sky pillar rises from the ground.
pos 0 100 0
find_connection sinkhole 4
settle
wait 30
expect_image crates/engine/tests/golden/sinkhole_top.png
expect_block -3266 -150 7266 air
expect_block -3266 -300 7266 air
expect_block -3186 -150 7266 stone
check_apron -103 -5 227
check_apron -103 -4 227
pos -3266 -470 7266
look 20 70
settle
wait 30
expect_image crates/engine/tests/golden/sinkhole_bottom.png
pos 0 100 0
find_connection pillar
settle
wait 30
expect_image crates/engine/tests/golden/sky_pillar.png
# the pillar through the open air between the layers (each half generated by the nearer layer)
# and into the sky layer
expect_block 2514 1500 -4325 stone
expect_block 2514 3000 -4325 stone
expect_block 2514 4300 -4325 stone
expect_block 2700 2000 -4325 air
