# Generation consistency: a chunk's apron cells (generated by the chunk itself, for meshing and
# lighting) must match the blocks its neighbours generate. Each place once disagreed:
ui off

# forest: cave ceilings, ground cover and cave plants owned by the chunk below; a cave below
# sea level whose roof is further up than one chunk looks (flooding)
pos 144 136 -368
settle
check_apron 4 1 -12
check_apron 4 2 -12
check_apron 4 1 -11
check_apron 4 2 -11
check_apron 7 1 -10

# desert: 12 blocks of sandstone, deeper than one chunk looks ahead
pos -1184 142 2784
settle
check_apron -36 -2 87
check_apron -36 -1 87
check_apron -36 0 87
check_apron -36 1 87

# lava fields: an obsidian spike on a lake floor under another surface (prop anchors)
pos -2240 73 1920
settle
check_apron -70 0 60
check_apron -70 1 60

# taiga: overlapping trees (prop drawing order)
pos -128 90 4000
settle
check_apron -3 2 126
check_apron -4 2 126

# layer boundaries: cells are generated by the layer owning their height, so chunks across a
# boundary are generated by two layers (the surface over the upper caves at y -128, the two
# underground bands at y -1200, the bottom of the sky at y 4000) and the sky's islands
pos 40 -110 40
settle
check_apron 1 -5 1
check_apron 1 -4 1
check_apron 1 -38 1
check_apron 1 -37 1
check_apron 1 124 1
pos 0 4800 0
settle
check_apron 1 150 2
check_apron 2 149 2
