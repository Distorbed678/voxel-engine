# Rendering regression: frames compared against crates/engine/tests/golden/*.png
# (half resolution). Rewrite the goldens after an intended visual change with UPDATE_GOLDEN=1.
ui off
anim 12

# daylight, shadows, clouds, water
time 0.36
pos 144 136 -368
look 90 4
settle
wait 240
expect_image crates/engine/tests/golden/daylight.png

# solo preview: the same view with one biome everywhere (the images after this one check that
# turning it off brings the world back)
solo biome desert
settle
wait 240
expect_image crates/engine/tests/golden/solo_desert.png
solo off

# terracotta strata, biome blending
time 0.42
pos -1184 142 2784
look 35 -14
settle
wait 240
expect_image crates/engine/tests/golden/badlands.png

# night: moon, stars, dark fog
time 0.02
pos 144 110 3280
look 60 6
settle
wait 240
expect_image crates/engine/tests/golden/night.png

# emissive lava at dusk
time 0.78
pos -2224 107 1968
look 35 -14
settle
wait 240
expect_image crates/engine/tests/golden/lava.png

# debug views: biome map from above, normals
time 0.40
clouds off
pos 0 900 0
look 30 -55
settle
view 9
wait 4
expect_image crates/engine/tests/golden/view_biomes.png
pos 144 136 -368
look 90 -10
settle
view 1
wait 4
expect_image crates/engine/tests/golden/view_normals.png

# block light: a sealed room with coloured light sources (lantern, lamp, crystal, glow
# mushrooms), then the lamp removed: its light has to fade again
view 0
clouds on
time 0.02
select -12 380 -12 12 390 12
block stone
op fill
select -11 381 -11 11 389 11
op clear
select -6 381 0 -6 381 0
block lantern
op fill
select 6 381 -4 6 381 -4
block lamp
op fill
select 0 381 8 0 381 8
block crystal
op fill
select 4 381 6 4 381 6
block mushroom_glow
op fill
select -8 381 -8 -8 381 -8
op fill
pos 0.5 387 -10
look 180 -30
settle
wait 30
expect_image crates/engine/tests/golden/room_light.png
select 6 381 -4 6 381 -4
op clear
settle
wait 30
expect_image crates/engine/tests/golden/room_lamp_removed.png

# cave biomes: a lush cave (moss, glow mushrooms, crystal accents) lit only by block light
time 0.36
pos 900 60 -400
find_cave 10
look 0 -15
settle
wait 60
expect_image crates/engine/tests/golden/cave.png

# rivers from above: channels at sea level through forest and meadow
clouds off
pos 200 700 -300
look 0 -89
settle
wait 30
expect_image crates/engine/tests/golden/rivers.png

# weather: heavy snowfall over the taiga (particles restart when settle finishes)
clouds on
weather 1
time 0.33
pos -128 90 4000
look 35 -5
settle
wait 120
expect_image crates/engine/tests/golden/weather.png

# the layers: the sky's floating isles, the upper caves and the Deep (each its own generator)
weather 0
time 0.4
pos 0 4800 0
look 30 0
settle
wait 240
expect_image crates/engine/tests/golden/sky_islands.png
# the cloud sea: from above (the sky layer's islands over it), from below (an overcast that fades
# in near its base; from the ground the sky looks normal)
pos 0 5200 0
look 30 -25
settle
wait 120
expect_image crates/engine/tests/golden/cloud_sea_above.png
pos 0 2400 0
look 30 20
settle
wait 120
expect_image crates/engine/tests/golden/cloud_sea_below.png
pos 0 -500 0
look 30 -10
settle
wait 240
expect_image crates/engine/tests/golden/upper_caves.png
pos 0 -3000 0
look 30 -10
settle
wait 240
expect_image crates/engine/tests/golden/deep.png
