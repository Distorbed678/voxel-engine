#version 460
// GPU greedy mesher. Runs twice per batch:
//   count pass  (no MESH_WRITE): counts quads per (job, stream, slice) into `table`
//   write pass  (MESH_WRITE):    re-runs the identical greedy walk and writes the quads at the
//                                exclusive offsets produced by prefix.comp
// One invocation handles one 32x32 slice for one face direction of one chunk.
// Faces with identical block + identical AO pattern merge; the fragment shader evaluates AO
// per cell (fract of the cell coordinate) so merged quads look identical to unmerged ones.
#include "common.glsl"
#include "voxel.glsl"

layout(local_size_x = 32) in;

layout(push_constant, scalar) uniform PC {
    VoxelBuf voxels;
    BlockTable blocks;
    ColumnBuf columns;
    U32Buf table;          // [job][stream][slice]
    JobResultBuf results;
    UVec2Buf scratch;
    uint numJobs;
    uint scratchCapacity;
} pc;

uint gBase;
uint gJob;

uint vox(ivec3 p) { return uint(pc.voxels.v[gBase + vidx(p)]); }
uint kindOf(uint b) { return pc.blocks.b[BLOCK_ID(b)].flags & 15u; }

// Water surface height order: falling water is full height, then still water, then flowing
// levels 1..7, each lower (see fluid.rs).
uint waterRank(uint v) {
    uint s = BLOCK_STATE(v);
    return s == 8u ? 9u : 8u - s;
}

// Does neighbour block `nb` hide the face of block `b` (kind kb)? `side`: a horizontal face.
bool occludes(uint nb, uint b, uint kb, bool side) {
    if (nb == 0u) return false;
    uint kn = kindOf(nb);
    if (kn == KIND_OPAQUE) return true;
    if (BLOCK_ID(nb) == BLOCK_ID(b) && (kb == KIND_CUTOUT || kb == KIND_TRANSPARENT)) {
        // water steps down: the side of the higher water shows above the lower neighbour
        if (side && BLOCK_STATE(nb) != BLOCK_STATE(b)) return waterRank(nb) >= waterRank(b);
        return true;
    }
    // transparent blocks are hidden by any non-air cube neighbour except other transparents
    if (kb == KIND_TRANSPARENT && kn == KIND_CUTOUT) return true;
    return false;
}

bool aoOcc(ivec3 p) {
    uint b = vox(p);
    if (b == 0u) return false;
    uint k = kindOf(b);
    return k == KIND_OPAQUE || k == KIND_CUTOUT;
}

uint aoCorner(bool s1, bool s2, bool c) {
    return (s1 && s2) ? 0u : 3u - uint(s1) - uint(s2) - uint(c);
}

uint gAxis;
ivec3 gN, gU, gV;
int gS;

uint biomeAt(ivec3 p) {
    return uint(pc.columns.c[gJob * uint(CA * CA) + uint((p.z + 1) * CA + (p.x + 1))]) & BIOME_MASK;
}

// key: block(16) | ao(8) | transparent(1) << 31, biome in the high word
uint64_t faceKey(int u, int v) {
    ivec3 p = slice_pos(gAxis, gS, u, v);
    uint b = vox(p);
    uint kb = kindOf(b);
    uint biome = biomeAt(p);
    if (kb == KIND_TRANSPARENT) {
        return uint64_t(b | (0xFFu << 16) | (1u << 31)) | (uint64_t(biome) << 32);
    }
    ivec3 q = p + gN;
    bool xm = aoOcc(q - gU), xp = aoOcc(q + gU), ym = aoOcc(q - gV), yp = aoOcc(q + gV);
    bool mm = aoOcc(q - gU - gV), pm = aoOcc(q + gU - gV);
    bool pp = aoOcc(q + gU + gV), mp = aoOcc(q - gU + gV);
    uint ao = aoCorner(xm, ym, mm) | (aoCorner(xp, ym, pm) << 2) |
              (aoCorner(xp, yp, pp) << 4) | (aoCorner(xm, yp, mp) << 6);
    return uint64_t(b | (ao << 16)) | (uint64_t(biome) << 32);
}

void main() {
    uint dir = gl_WorkGroupID.x;
    uint job = gl_WorkGroupID.y;
    gS = int(gl_LocalInvocationID.x);
    gBase = job * SLOT_U16;
    gJob = job;
    gAxis = dir >> 1;
    gN = dir_normal(dir);
    gU = axis_u(gAxis);
    gV = axis_v(gAxis);

    uint nonAir = pc.results.r[job].nonAir;
    uint opaque = pc.results.r[job].opaque;
    bool skip = nonAir == 0u || opaque >= uint(CA * CA * CA) || (pc.results.r[job].flags & JOB_NO_MESH) != 0u;

    uint tbase = job * NUM_STREAMS * 32u;
    uint nO = 0u, nT = 0u, nM = 0u;

#ifdef MESH_WRITE
    uint flags = pc.results.r[job].flags;
    if ((flags & JOB_OVERFLOW) != 0u) skip = true;
    uint sbase = pc.results.r[job].scratchBase;
    uint offO = sbase + pc.table.v[tbase + dir * 32u + uint(gS)];
    uint offT = sbase + pc.table.v[tbase + (6u + dir) * 32u + uint(gS)];
    uint offM = sbase + pc.table.v[tbase + STREAM_MODELS * 32u + uint(gS)];
#endif

    if (!skip) {
        uint vis[32];
        for (int v = 0; v < 32; ++v) {
            uint m = 0u;
            for (int u = 0; u < 32; ++u) {
                ivec3 p = slice_pos(gAxis, gS, u, v);
                uint b = vox(p);
                if (b == 0u) continue;
                uint kb = kindOf(b);
                if (kb == KIND_MODEL) {
                    if (dir == 0u) {
#ifdef MESH_WRITE
                        // neighbour mask: which of the 6 neighbours are opaque (for face culling)
                        uint nmask = 0u;
                        for (uint d = 0u; d < 6u; ++d) {
                            uint nb = vox(p + dir_normal(d));
                            if (nb != 0u && kindOf(nb) == KIND_OPAQUE) nmask |= 1u << d;
                        }
                        pc.scratch.v[offM + nM] = uvec2(uint(p.x) | (uint(p.y) << 5) | (uint(p.z) << 10) | (nmask << 15), b | (biomeAt(p) << 16));
#endif
                        nM++;
                    }
                    continue;
                }
                if (kb == KIND_AIR) continue;
                uint nb = vox(p + gN);
                if (!occludes(nb, b, kb, gAxis != 1u)) m |= 1u << uint(u);
            }
            vis[v] = m;
        }

        for (int v = 0; v < 32; ++v) {
            while (vis[v] != 0u) {
                int u = findLSB(vis[v]);
                uint64_t key = faceKey(u, v);
                int w = 1;
                while (u + w < 32 && ((vis[v] >> uint(u + w)) & 1u) != 0u && faceKey(u + w, v) == key) {
                    w++;
                }
                uint rowMask = (w >= 32 ? 0xFFFFFFFFu : ((1u << uint(w)) - 1u)) << uint(u);
                vis[v] &= ~rowMask;
                int h = 1;
                while (v + h < 32) {
                    if ((vis[v + h] & rowMask) != rowMask) break;
                    bool ok = true;
                    for (int k = 0; k < w; ++k) {
                        if (faceKey(u + k, v + h) != key) { ok = false; break; }
                    }
                    if (!ok) break;
                    vis[v + h] &= ~rowMask;
                    h++;
                }
                uint klo = uint(key);
                bool transparent = (klo >> 31) != 0u;
#ifdef MESH_WRITE
                uvec2 q = pack_quad(uint(u), uint(v), uint(gS), uint(w), uint(h), dir,
                                    klo & 0xFFFFu, (klo >> 16) & 0xFFu, uint(key >> 32));
                if (transparent) pc.scratch.v[offT + nT] = q;
                else pc.scratch.v[offO + nO] = q;
#endif
                if (transparent) nT++; else nO++;
            }
        }
    }

#ifndef MESH_WRITE
    pc.table.v[tbase + dir * 32u + uint(gS)] = nO;
    pc.table.v[tbase + (6u + dir) * 32u + uint(gS)] = nT;
    if (dir == 0u) pc.table.v[tbase + STREAM_MODELS * 32u + uint(gS)] = nM;
#endif
}
