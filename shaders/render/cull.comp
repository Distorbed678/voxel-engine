#version 460
// Chunk-level GPU culling: frustum + per-face-direction back-face culling.
// Emits task-shader draw groups (<= MAX_DRAW_QUADS quads each) for opaque and transparent quads.
#include "common.glsl"
#include "voxel.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform PC {
    FrameRef frame;
    ChunkRecordBuf records;
    DrawGroupBuf opaqueDraws;
    DrawGroupBuf transDraws;
    DrawGroupBuf modelDraws;
    U32Buf args;            // [0..2] opaque task dispatch, [3..5] transparent, [6] visible chunks, [7] total quads, [8..10] models
    uint numRecords;
    uint maxDraws;
    uint shadowPass;        // 1 = no back-face culling per direction, frustum only
    uint pad;
} pc;

bool faceVisible(uint dir, vec3 mn, vec3 mx) {
    // camera sits at the origin of camera-relative space
    switch (dir) {
        case 0u: return mn.x < 0.0;
        case 1u: return mx.x > 0.0;
        case 2u: return mn.y < 0.0;
        case 3u: return mx.y > 0.0;
        case 4u: return mn.z < 0.0;
        default: return mx.z > 0.0;
    }
}

void emit(DrawGroupBuf draws, uint argBase, uint chunk, uint offset, uint count, uint dir, uint maxPer) {
    for (uint start = 0u; start < count; start += maxPer) {
        uint idx = atomicAdd(pc.args.v[argBase], 1u);
        if (idx < pc.maxDraws) {
            draws.g[idx] = DrawGroup(chunk, offset + start, min(maxPer, count - start), dir);
        }
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numRecords) return;
    ChunkRecord rec = pc.records.c[i];
    if ((rec.lodFlags & RECORD_ACTIVE) == 0u) return;
    FrameData f = pc.frame.d;
    uint lod = rec.lodFlags & 15u;
    float size = float(CS << lod);
    vec3 mn = vec3(rec.origin - f.camBlock.xyz) - f.camFrac.xyz;
    vec3 mx = mn + size;
    for (int p = 0; p < 6; ++p) {
        vec4 pl = f.frustum[p];
        vec3 v = vec3(pl.x >= 0.0 ? mx.x : mn.x, pl.y >= 0.0 ? mx.y : mn.y, pl.z >= 0.0 ? mx.z : mn.z);
        if (dot(pl.xyz, v) + pl.w < 0.0) return;
    }
    atomicAdd(pc.args.v[6], 1u);
    uint offset = rec.quadBase;
    uint quads = 0u;
    for (uint d = 0u; d < 6u; ++d) {
        uint c = rec.counts[d];
        if (c > 0u && faceVisible(d, mn, mx)) {
            emit(pc.opaqueDraws, 0u, i, offset, c, d, MAX_DRAW_QUADS);
            quads += c;
        }
        offset += c;
    }
    for (uint d = 0u; d < 6u; ++d) {
        uint c = rec.counts[6u + d];
        if (c > 0u && faceVisible(d, mn, mx)) {
            emit(pc.transDraws, 3u, i, offset, c, d, MAX_DRAW_QUADS);
            quads += c;
        }
        offset += c;
    }
    uint nm = rec.counts[STREAM_MODELS];
    if (nm > 0u && lod <= 1u) emit(pc.modelDraws, 8u, i, offset, nm, 6u, 192u);
    atomicAdd(pc.args.v[7], quads);
}
