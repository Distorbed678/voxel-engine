#version 460
#include "render/terrain_common.glsl"

layout(local_size_x = 1) in;

taskPayloadSharedEXT TaskPayload pl;

#define MODELS_PER_MESHLET 6u

void main() {
    DrawGroup g = pc.draws.g[gl_WorkGroupID.x];
    pl.chunk = g.chunk;
    pl.quadOffset = g.quadOffset;
    pl.quadCount = g.quadCount;
    pl.group = gl_WorkGroupID.x;
    EmitMeshTasksEXT((g.quadCount + MODELS_PER_MESHLET - 1u) / MODELS_PER_MESHLET, 1u, 1u);
}
