#version 460
// Expands packed quads (8 bytes each) into triangles. 32 threads x 2 quads = 64 quads per meshlet.
#include "render/terrain_common.glsl"

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 256, max_primitives = 128) out;

taskPayloadSharedEXT TaskPayload pl;

layout(location = 0) out vec3 vRel[];
layout(location = 1) out vec3 vLocal[];
layout(location = 2) perprimitiveEXT flat out uvec2 pQuad[];
layout(location = 3) perprimitiveEXT flat out uint pMeta[];

void main() {
    uint meshlet = gl_WorkGroupID.x;
    uint first = meshlet * 64u;
    uint n = min(64u, pl.quadCount - first);
    SetMeshOutputsEXT(n * 4u, n * 2u);

    FrameData f = pc.frame.d;
    ChunkRecord rec = pc.records.c[pl.chunk];
    uint lod = rec.lodFlags & 15u;
    float scale = float(1u << lod);
    // integer offset of the chunk from the camera block; corners are added to it exactly before
    // the fractional camera offset is subtracted, so vertices shared by neighbouring chunks are
    // bit-identical (otherwise water and ice show double-blended seams along chunk borders)
    ivec3 relOriginI = rec.origin - f.camBlock.xyz;
    uint meta = hash_u32(pl.chunk * 7919u + pl.group * 131u + meshlet);

    for (uint k = 0u; k < 2u; ++k) {
        uint qi = gl_LocalInvocationID.x * 2u + k;
        if (qi >= n) continue;
        uvec2 q = pc.quads.v[pl.quadOffset + first + qi];
        uint u = q.x & 31u;
        uint v = (q.x >> 5) & 31u;
        uint s = (q.x >> 10) & 31u;
        uint w = ((q.x >> 15) & 31u) + 1u;
        uint h = ((q.x >> 20) & 31u) + 1u;
        uint dir = (q.x >> 25) & 7u;
        uint axis = dir >> 1;
        bool positive = (dir & 1u) == 0u;
        float plane = float(s) + (positive ? 1.0 : 0.0);
        vec3 U = vec3(axis_u(axis));
        vec3 V = vec3(axis_v(axis));
        vec3 A = vec3(0.0);
        A[axis] = plane;
        vec3 c0 = A + U * float(u) + V * float(v);
        vec3 corners[4] = vec3[4](c0, c0 + U * float(w), c0 + U * float(w) + V * float(h), c0 + V * float(h));
        uint vb = qi * 4u;
        uint blk = q.y & 0xFFFFu;
        bool sway = lod == 0u && (pc.blocks.b[BLOCK_ID(blk)].flags & 15u) == KIND_CUTOUT;
        // water surfaces sit below the top of their cell (the same at every LOD): 1/8 for still
        // water, one more 1/8 per level for flowing water, none for falling water. The top edge
        // of an exposed water side drops with them so it doesn't stick up past the surface.
        bool water = dir != 3u && (pc.blocks.b[BLOCK_ID(blk)].flags & BLOCK_FLUID) != 0u;
        uint wl = BLOCK_STATE(blk);
        float drop = wl == 8u ? 0.0 : min(float(wl + 1u) * 0.125, 0.9375);
        float topY = max(max(corners[0].y, corners[1].y), max(corners[2].y, corners[3].y));
        for (uint c = 0u; c < 4u; ++c) {
            vec3 local = corners[c] * scale;
            vec3 rel = vec3(relOriginI + ivec3(local)) - f.camFrac.xyz;
            if (water && corners[c].y == topY) rel.y -= drop;
            if (sway) {
                // position-based sway keeps neighbouring leaf quads welded together
                vec3 wp = vec3(rec.origin & 1023) + local;
                float w = sin(f.time * 1.4 + wp.x * 0.31 + wp.z * 0.23 + wp.y * 0.17) + 0.4 * sin(f.time * 2.7 + wp.z * 0.8);
                rel += vec3(w * 0.045, 0.0, w * 0.035);
            }
            vLocal[vb + c] = local;
            vRel[vb + c] = rel;
#ifdef SHADOW
            gl_MeshVerticesEXT[vb + c].gl_Position = f.shadowVP[pc.flags & 3u] * vec4(rel, 1.0);
#else
            gl_MeshVerticesEXT[vb + c].gl_Position = f.viewProj * vec4(rel, 1.0);
#endif
        }
        uint pb = qi * 2u;
        if (positive) {
            gl_PrimitiveTriangleIndicesEXT[pb] = uvec3(vb, vb + 1u, vb + 2u);
            gl_PrimitiveTriangleIndicesEXT[pb + 1u] = uvec3(vb, vb + 2u, vb + 3u);
        } else {
            gl_PrimitiveTriangleIndicesEXT[pb] = uvec3(vb, vb + 2u, vb + 1u);
            gl_PrimitiveTriangleIndicesEXT[pb + 1u] = uvec3(vb, vb + 3u, vb + 2u);
        }
        // for the fragment shader: dir and lod, the biome in the low bits; block and ao
        uvec2 packed = uvec2((q.x & (7u << 25)) | (lod << 28) | quad_biome(q), q.y & 0x00FFFFFFu);
        pQuad[pb] = packed;
        pQuad[pb + 1u] = packed;
        pMeta[pb] = meta;
        pMeta[pb + 1u] = meta;
    }
}
