#version 460
// Bloom downsample (13-tap filter from "Next Generation Post Processing in Call of Duty: Advanced
// Warfare"). The first pass from the full-resolution image applies a soft brightness threshold
// and a Karis average per 2x2 group, so single bright pixels don't flicker.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rgba16f) uniform image2D gImageRGBA16F[];

layout(push_constant, scalar) uniform PC {
    uint src;         // sampled, linear clamp
    uint dst;         // storage
    ivec2 dstSize;
    vec2 srcTexel;    // 1 / source size
    uint first;
    float threshold;  // exposure-scaled brightness where bloom starts
    float exposure;
} pc;

vec3 s(vec2 uv) { return texture(gTex2D[nonuniformEXT(pc.src)], uv).rgb; }

// soft threshold (quadratic knee) in exposure-scaled units, result in scene units
vec3 prefilter(vec3 c) {
    vec3 e = c * pc.exposure;
    float br = max(e.r, max(e.g, e.b));
    float knee = max(pc.threshold * 0.5, 1e-4);
    float soft = clamp(br - pc.threshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee);
    return c * (max(soft, br - pc.threshold) / max(br, 1e-4));
}

float karis(vec3 c) { return 1.0 / (1.0 + dot(c * pc.exposure, vec3(0.2126, 0.7152, 0.0722))); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.dstSize))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.dstSize);
    vec2 t = pc.srcTexel;
    vec3 a = s(uv + t * vec2(-2, -2)), b = s(uv + t * vec2(0, -2)), c = s(uv + t * vec2(2, -2));
    vec3 d = s(uv + t * vec2(-2, 0)),  e = s(uv),                    f = s(uv + t * vec2(2, 0));
    vec3 g = s(uv + t * vec2(-2, 2)),  h = s(uv + t * vec2(0, 2)),  i = s(uv + t * vec2(2, 2));
    vec3 j = s(uv + t * vec2(-1, -1)), k = s(uv + t * vec2(1, -1));
    vec3 l = s(uv + t * vec2(-1, 1)),  m = s(uv + t * vec2(1, 1));
    vec3 res;
    if (pc.first != 0u) {
        vec3 g0 = prefilter((j + k + l + m) * 0.25);
        vec3 g1 = prefilter((a + b + d + e) * 0.25);
        vec3 g2 = prefilter((b + c + e + f) * 0.25);
        vec3 g3 = prefilter((d + e + g + h) * 0.25);
        vec3 g4 = prefilter((e + f + h + i) * 0.25);
        float w0 = karis(g0) * 0.5, w1 = karis(g1) * 0.125, w2 = karis(g2) * 0.125;
        float w3 = karis(g3) * 0.125, w4 = karis(g4) * 0.125;
        res = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / (w0 + w1 + w2 + w3 + w4);
    } else {
        res = e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
    }
    imageStore(gImageRGBA16F[pc.dst], p, vec4(max(res, vec3(0.0)), 1.0));
}
