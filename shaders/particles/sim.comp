#version 460
// Particle simulation: respawn free slots with a type picked from the active types' shares (where
// its spawn rules allow), move by the type's motion, wrap around the camera box, and kill
// particles inside solid blocks (or, for open-sky types like rain and snow, under a roof) using
// the light volume around the camera.
#include "particles/particles_common.glsl"
#include "light/light_defs.glsl"

layout(local_size_x = 64) in;
layout(set = 0, binding = 1, r16ui) uniform uimage3D gLightBlocks[];

// the block (raw light-volume value) at box position `pos` + `off`
uint block_at(FrameData f, vec3 pos, ivec3 off) {
    ivec3 w = f.camBlock.xyz + ivec3(floor(box_rel(f, pos) + f.camFrac.xyz)) + off;
    return imageLoad(gLightBlocks[pc.lightBlocks], w & LIGHT_MASK).r;
}

bool near_class(uint id, uint near, uint nearBlock) {
    if (id == 0u) return false;
    BlockInfo b = pc.blocks.b[id];
    uint kind = b.flags & 15u;
    switch (near) {
        case NEAR_LEAVES: return kind == KIND_CUTOUT;
        case NEAR_PLANTS: return kind == KIND_MODEL;
        case NEAR_WATER: return (b.flags & BLOCK_FLUID) != 0u && (b.light & 0xFFFFFFu) == 0u;
        case NEAR_GLOWING: return (b.light & 0xFFFFFFu) != 0u;
        case NEAR_GROUND: return kind == KIND_OPAQUE;
        default: return id == nearBlock;
    }
}

// whether a block of the type's class is next to (or under) the spawn point
bool near_ok(FrameData f, vec3 pos, uvec4 spawn) {
    if (spawn.y == NEAR_ANYWHERE) return true;
    if (pc.lightBlocks == 0xFFFFFFFFu) return false;
    const ivec3 offs[8] = ivec3[8](ivec3(0), ivec3(0, -1, 0), ivec3(0, -2, 0), ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 0, 1), ivec3(0, 0, -1), ivec3(0, 1, 0));
    for (int k = 0; k < 8; ++k) {
        if (near_class(block_at(f, pos, offs[k]) & ID_MASK, spawn.y, spawn.z)) return true;
    }
    return false;
}

bool is_active(uint kind) {
    for (uint k = 0u; k < ACTIVE_TYPES; ++k) {
        if (pc.activeKind[k] == kind && pc.share[k] >= 1e-3) return true;
    }
    return false;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    FrameData f = pc.frame.d;
    Particle q = pc.particles.p[i];
    uint fr = pc.frameIndex;
    vec2 wind = pc.wind;

    if (q.life <= 0.0) {
        // spawn (or stay free): the type is picked from the slot shares, then its spawn rules
        float u = phash(i, fr * 3u + 1u);
        float acc = 0.0;
        uint kind = PK_NONE;
        for (uint k = 0u; k < ACTIVE_TYPES; ++k) {
            acc += pc.share[k];
            if (u < acc) { kind = pc.activeKind[k]; break; }
        }
        q.pos = vec3(phash(i, fr * 7u + 2u), phash(i, fr * 7u + 3u), phash(i, fr * 7u + 4u)) * PBOX;
        q.vel = vec3(0.0);
        float r = phash(i, fr * 5u + 9u);
        if (kind != PK_NONE && !near_ok(f, q.pos, pc.types.t[kind - 1u].spawn)) kind = PK_NONE;
        q.kind = kind;
        q.life = kind == PK_NONE ? 0.25 + r : pc.types.t[kind - 1u].look.w * (0.6 + 0.8 * r);
    } else if (q.kind != PK_NONE) {
        ParticleType T = pc.types.t[q.kind - 1u];
        float t = f.time;
        float s = float(i % 997u);
        float speed = T.motion.y;
        float sway = T.motion.z;
        vec3 target;
        switch (uint(T.motion.x)) {
            case MOTION_DRIFT: target = vec3(0.0, -speed + 0.6 * sway * sin(t * 0.8 + s * 2.1), 0.0); break;
            case MOTION_RISE: target = vec3(0.0, speed, 0.0); break;
            case MOTION_SWIRL: {
                // around the camera's vertical axis, pulled back towards a ring
                vec3 rel = box_rel(f, q.pos);
                vec2 d = rel.xz + vec2(1e-3);
                float len = length(d);
                vec2 tangent = vec2(-d.y, d.x) / len;
                vec2 pull = d / len * (PBOX * 0.2 - len) * 0.1;
                target = vec3(tangent.x * speed + pull.x, 0.3 * speed * sin(t * 0.7 + s), tangent.y * speed + pull.y);
                break;
            }
            case MOTION_WANDER: target = vec3(sin(t * 0.7 + s * 3.1), 0.5 * sin(t * 1.1 + s), cos(t * 0.6 + s * 1.7)) * speed; break;
            case MOTION_FLOCK: {
                // groups of 24 share a slowly turning heading
                float g = float(i / 24u);
                vec3 heading = vec3(sin(t * 0.31 + g * 1.7), 0.35 * sin(t * 0.53 + g * 2.3), cos(t * 0.27 + g * 1.3));
                target = heading * speed + vec3(sin(t * 2.1 + s), sin(t * 1.7 + s * 1.3), cos(t * 1.9 + s)) * 0.15 * speed;
                break;
            }
            case MOTION_ORBIT: {
                // groups of 16 circle a point of the box
                uint g = i / 16u;
                vec3 c = vec3(phash(g, 11u), phash(g, 12u), phash(g, 13u)) * PBOX;
                vec3 d = q.pos - c;
                d -= PBOX * floor(d / PBOX + 0.5);
                vec2 h = d.xz + vec2(1e-3);
                float len = length(h);
                float radius = 1.5 + 3.0 * phash(g, 14u);
                vec2 tangent = vec2(-h.y, h.x) / len;
                vec2 pull = h / len * (radius - len);
                target = vec3(tangent.x * speed + pull.x, -d.y * 0.5 + 0.3 * sin(t + s), tangent.y * speed + pull.y);
                break;
            }
            default: target = vec3(0.0, -speed, 0.0); break;
        }
        target += sway * vec3(sin(t * 0.9 + s), 0.0, cos(t * 0.7 + s * 1.3)) + vec3(wind.x, 0.0, wind.y) * T.motion.w;
        q.vel = mix(q.vel, target, clamp(pc.dt * 3.0, 0.0, 1.0));
        // types no longer wanted here (environment or weather changed) fade out quickly
        if (!is_active(q.kind)) q.life = min(q.life, 0.5) - pc.dt;
        q.pos = mod(q.pos + q.vel * pc.dt, PBOX);
        q.life -= pc.dt;
    } else {
        q.life -= pc.dt;
    }
    // checked for new particles too, which are drawn this frame: otherwise rain respawning in a
    // cave flashes for a frame wherever it lands
    if (q.kind != PK_NONE && q.life > 0.0 && pc.lightBlocks != 0xFFFFFFFFu) {
        // the light volume (128³ around the camera) contains the whole particle box
        uint raw = block_at(f, q.pos, ivec3(0));
        uint id = raw & ID_MASK;
        bool solid = id != 0u && (pc.blocks.b[id].light >> 28 & 1u) != 0u;
        bool covered = (raw >> SKY_SHIFT) < 15u;
        if (solid || ((pc.types.t[q.kind - 1u].spawn.x & SPAWN_OPEN_SKY) != 0u && covered)) q.life = 0.0;
    }
    pc.particles.p[i] = q;
}
