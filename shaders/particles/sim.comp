#version 460
// Particle simulation: respawn free slots with a kind picked from the weights, move, wrap around the
// camera box, and kill particles inside solid blocks (or, for rain and snow, under a roof) using
// the light volume around the camera.
#include "particles/particles_common.glsl"
#include "light/light_defs.glsl"

layout(local_size_x = 64) in;
layout(set = 0, binding = 1, r16ui) uniform uimage3D gLightBlocks[];

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    FrameData f = pc.frame.d;
    Particle q = pc.particles.p[i];
    uint fr = pc.frameIndex;
    vec2 wind = pc.weights1.zw;

    if (q.life <= 0.0) {
        // spawn (or stay free): the kind is picked from the slot shares
        float u = phash(i, fr * 3u + 1u);
        float acc = 0.0;
        uint kind = PK_NONE;
        float w[6] = float[6](pc.weights0.x, pc.weights0.y, pc.weights0.z, pc.weights0.w, pc.weights1.x, pc.weights1.y);
        for (uint k = 0u; k < 6u; ++k) {
            acc += w[k];
            if (u < acc) { kind = k + 1u; break; }
        }
        q.kind = kind;
        q.pos = vec3(phash(i, fr * 7u + 2u), phash(i, fr * 7u + 3u), phash(i, fr * 7u + 4u)) * PBOX;
        q.vel = vec3(0.0);
        float r = phash(i, fr * 5u + 9u);
        q.life = kind == PK_NONE ? 0.25 + r : (kind == PK_EMBER ? 2.0 + 3.0 * r : (kind == PK_RAIN ? 6.0 : 8.0 + 12.0 * r));
    } else {
        float t = f.time;
        float s = float(i % 997u);
        vec3 target;
        switch (q.kind) {
            case PK_SNOW: target = vec3(wind.x * 0.6 + 0.35 * sin(t * 0.9 + s), -1.3, wind.y * 0.6 + 0.35 * cos(t * 0.7 + s * 1.3)); break;
            case PK_RAIN: target = vec3(wind.x * 1.5, -13.0, wind.y * 1.5); break;
            case PK_ASH: target = vec3(wind.x * 0.5 + 0.4 * sin(t * 0.5 + s), -0.35 + 0.25 * sin(t * 0.8 + s * 2.1), wind.y * 0.5 + 0.4 * cos(t * 0.6 + s)); break;
            case PK_EMBER: target = vec3(0.6 * sin(t * 2.0 + s), 1.4, 0.6 * cos(t * 1.7 + s)) + vec3(wind.x, 0.0, wind.y) * 0.3; break;
            case PK_FIREFLY: target = vec3(sin(t * 0.7 + s * 3.1), 0.5 * sin(t * 1.1 + s), cos(t * 0.6 + s * 1.7)) * 0.9; break;
            default: target = vec3(wind.x * 0.4 + 0.2 * sin(t * 0.6 + s), -0.08 + 0.15 * sin(t + s), wind.y * 0.4 + 0.2 * cos(t * 0.5 + s)); break;
        }
        q.vel = mix(q.vel, target, clamp(pc.dt * 3.0, 0.0, 1.0));
        // kinds that are no longer wanted here (biome or weather changed) fade out quickly
        float w[6] = float[6](pc.weights0.x, pc.weights0.y, pc.weights0.z, pc.weights0.w, pc.weights1.x, pc.weights1.y);
        if (q.kind != PK_NONE && w[q.kind - 1u] < 1e-3) q.life = min(q.life, 0.5) - pc.dt;
        q.pos = mod(q.pos + q.vel * pc.dt, PBOX);
        q.life -= pc.dt;
        if (q.kind != PK_NONE && pc.lightBlocks != 0xFFFFFFFFu) {
            // the light volume (128³ around the camera) contains the whole particle box
            ivec3 w = f.camBlock.xyz + ivec3(floor(box_rel(f, q.pos) + f.camFrac.xyz));
            uint raw = imageLoad(gLightBlocks[pc.lightBlocks], w & LIGHT_MASK).r;
            uint id = raw & ID_MASK;
            bool solid = id != 0u && (pc.blocks.b[id].light >> 28 & 1u) != 0u;
            bool covered = (raw >> SKY_SHIFT) < 15u;
            if (solid || ((q.kind == PK_SNOW || q.kind == PK_RAIN) && covered)) q.life = 0.0;
        }
    }
    pc.particles.p[i] = q;
}
